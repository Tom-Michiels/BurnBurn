{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burnburn-plugin/1/manifest",
  "title": "BurnBurn plugin manifest, API burnburn-plugin/1",
  "description": "Contract only (decision B-5: no plugins in v1, no loader in the application). Validated by burnburn_cli::plugin_manifest::validate_manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api", "name", "version", "kind", "command", "capabilities"],
  "properties": {
    "api": { "const": "burnburn-plugin/1" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "version": { "type": "string" },
    "kind": { "enum": ["generator", "importer", "exporter"] },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Executable and arguments; the first item must not be empty. Started out of process by the host with a timeout."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "network", "machine"],
      "properties": {
        "files": { "enum": ["none", "host-provided"] },
        "network": { "const": false },
        "machine": { "const": false }
      }
    }
  },
  "examples": [
    {
      "api": "burnburn-plugin/1",
      "name": "box-maker",
      "version": "0.3.1",
      "kind": "generator",
      "command": ["box-maker", "--stdio"],
      "capabilities": { "files": "host-provided", "network": false, "machine": false }
    },
    {
      "api": "burnburn-plugin/1",
      "name": "dxf-extra",
      "version": "1.0.0",
      "kind": "importer",
      "command": ["dxf-extra"],
      "capabilities": { "files": "none", "network": false, "machine": false }
    }
  ]
}
